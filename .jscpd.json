{
    "gitignore": true,
    "ignore": [
        "**/node_modules/**",
        "**/.git/**",
        "**/*.md",
        "**/.tmp-pycompat/**",
        "**/.venv-py311-backup/**",
        "**/venv3.14/**",
        "**/.venv/**",
        "**/tests/**",
        "**/*.css",
        "**/*.sh",
        "**/style_audit.mjs",
        "**/scripts/**",
        "**/report/**",
        "*.html",
        "*.txt",
        "*.svg",
        "*.yaml",
        "*.yml",
        "*.csv",
        "*.json",
        "*.toml"
    ],
    "mode": "strict",
    "reporters": ["html", "markdown"],
    "threshold": 0.1
}
