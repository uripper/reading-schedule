{
    "$description": "Reading Schedule design tokens (DTCG style)",
    "$schema": "https://www.designtokens.org/schema.json",
    "elevation": {
        "md": {
            "$type": "shadow",
            "$value": "0 10px 20px rgba(0, 0, 0, 0.25)"
        },
        "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(0, 0, 0, 0.26)" }
    },
    "motion": {
        "duration": {
            "base": { "$type": "duration", "$value": "180ms" },
            "fast": { "$type": "duration", "$value": "120ms" },
            "slow": { "$type": "duration", "$value": "260ms" }
        },
        "easing": {
            "standard": {
                "$type": "cubicBezier",
                "$value": "cubic-bezier(0.2, 0, 0, 1)"
            }
        }
    },
    "radius": {
        "lg": { "$type": "dimension", "$value": "16px" },
        "md": { "$type": "dimension", "$value": "12px" },
        "pill": { "$type": "dimension", "$value": "999px" },
        "sm": { "$type": "dimension", "$value": "8px" }
    },
    "size": {
        "header": {
            "height": { "$type": "dimension", "$value": "72px" }
        },
        "target": {
            "minimum": { "$type": "dimension", "$value": "44px" }
        }
    },
    "space": {
        "0": { "$type": "dimension", "$value": "0px" },
        "1": { "$type": "dimension", "$value": "4px" },
        "2": { "$type": "dimension", "$value": "8px" },
        "3": { "$type": "dimension", "$value": "12px" },
        "4": { "$type": "dimension", "$value": "16px" },
        "5": { "$type": "dimension", "$value": "20px" },
        "6": { "$type": "dimension", "$value": "24px" },
        "8": { "$type": "dimension", "$value": "32px" },
        "10": { "$type": "dimension", "$value": "40px" }
    },
    "typography": {
        "family": {
            "body": {
                "$type": "fontFamily",
                "$value": "\"Archivo\", sans-serif"
            },
            "heading": {
                "$type": "fontFamily",
                "$value": "\"Plus Jakarta Sans\", sans-serif"
            },
            "mono": {
                "$type": "fontFamily",
                "$value": "\"Space Mono\", monospace"
            }
        },
        "lineHeight": {
            "base": { "$type": "number", "$value": "1.5" },
            "tight": { "$type": "number", "$value": "1.2" }
        },
        "size": {
            "display": {
                "$type": "fontSize",
                "$value": "clamp(3rem, 6vw, 4.25rem)"
            },
            "heading-lg": {
                "$type": "fontSize",
                "$value": "clamp(2rem, 3vw, 2.8rem)"
            },
            "heading-md": {
                "$type": "fontSize",
                "$value": "clamp(1.2rem, 2.2vw, 2.7rem)"
            },
            "heading-sm": {
                "$type": "fontSize",
                "$value": "clamp(1.2rem, 2vw, 1.6rem)"
            },
            "lg": { "$type": "fontSize", "$value": "1.2rem" },
            "md": { "$type": "fontSize", "$value": "1rem" },
            "xl": { "$type": "fontSize", "$value": "1.6rem" }
        },
        "weight": {
            "bold": { "$type": "fontWeight", "$value": "700" },
            "extrabold": { "$type": "fontWeight", "$value": "800" },
            "medium": { "$type": "fontWeight", "$value": "500" },
            "regular": { "$type": "fontWeight", "$value": "400" },
            "semibold": { "$type": "fontWeight", "$value": "600" }
        }
    },
    "control": {
        "$description": "Shared shape for inputs, selects, comboboxes, chips, toggles and menus.",
        "borderWidth": { "$type": "dimension", "$value": "2px" },
        "chipGap": { "$type": "dimension", "$value": "4px" },
        "focusOffset": { "$type": "dimension", "$value": "4px" },
        "menuMaxHeight": { "$type": "dimension", "$value": "320px" },
        "menuOffset": { "$type": "dimension", "$value": "4px" },
        "menuViewportPadding": { "$type": "dimension", "$value": "8px" },
        "radius": { "$type": "dimension", "$value": "4px" },
        "thumbHeight": { "$type": "dimension", "$value": "48px" },
        "thumbWidth": { "$type": "dimension", "$value": "32px" }
    },
    "semantic": {
        "$description": "Role-based aliases emitted as --app-*; colors reference palette.css variables.",
        "accent": { "$type": "string", "$value": "var(--color-glacier)" },
        "accent-ink": { "$type": "string", "$value": "var(--color-black)" },
        "control-border": { "$type": "string", "$value": "var(--color-black)" },
        "control-ink": { "$type": "string", "$value": "var(--color-black)" },
        "control-placeholder": {
            "$type": "string",
            "$value": "var(--color-umber)"
        },
        "control-surface": {
            "$type": "string",
            "$value": "var(--color-white)"
        },
        "control-surface-muted": {
            "$type": "string",
            "$value": "var(--color-paper)"
        },
        "control-disabled-surface": {
            "$type": "string",
            "$value": "var(--color-gray-light)"
        },
        "control-focus-shadow": {
            "$type": "string",
            "$value": "var(--token-control-focusOffset) var(--token-control-focusOffset) 0 var(--color-black)"
        },
        "danger": { "$type": "string", "$value": "var(--color-salmon)" },
        "menu-highlight": {
            "$type": "string",
            "$value": "var(--color-glacier)"
        },
        "menu-shadow": { "$type": "string", "$value": "var(--shadow-md)" },
        "menu-surface": { "$type": "string", "$value": "var(--color-paper)" }
    }
}
