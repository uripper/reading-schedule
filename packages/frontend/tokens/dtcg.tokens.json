{
    "$description": "Reading Schedule design tokens (DTCG style)",
    "$schema": "https://www.designtokens.org/schema.json",
    "elevation": {
        "md": {
            "$type": "shadow",
            "$value": "0 10px 20px rgba(0, 0, 0, 0.25)"
        },
        "sm": { "$type": "shadow", "$value": "0 1px 2px rgba(0, 0, 0, 0.26)" }
    },
    "motion": {
        "duration": {
            "base": { "$type": "duration", "$value": "180ms" },
            "fast": { "$type": "duration", "$value": "120ms" },
            "slow": { "$type": "duration", "$value": "260ms" }
        },
        "easing": {
            "standard": {
                "$type": "cubicBezier",
                "$value": "cubic-bezier(0.2, 0, 0, 1)"
            }
        }
    },
    "radius": {
        "lg": { "$type": "dimension", "$value": "16px" },
        "md": { "$type": "dimension", "$value": "12px" },
        "pill": { "$type": "dimension", "$value": "999px" },
        "sm": { "$type": "dimension", "$value": "8px" }
    },
    "size": {
        "header": {
            "height": { "$type": "dimension", "$value": "72px" }
        },
        "target": {
            "minimum": { "$type": "dimension", "$value": "44px" }
        }
    },
    "space": {
        "0": { "$type": "dimension", "$value": "0px" },
        "1": { "$type": "dimension", "$value": "4px" },
        "2": { "$type": "dimension", "$value": "8px" },
        "3": { "$type": "dimension", "$value": "12px" },
        "4": { "$type": "dimension", "$value": "16px" },
        "5": { "$type": "dimension", "$value": "20px" },
        "6": { "$type": "dimension", "$value": "24px" },
        "8": { "$type": "dimension", "$value": "32px" },
        "10": { "$type": "dimension", "$value": "40px" }
    },
    "typography": {
        "family": {
            "heading": {
                "$type": "fontFamily",
                "$value": "\"Space Grotesk\", \"Plus Jakarta Sans\", sans-serif"
            },
            "mono": {
                "$type": "fontFamily",
                "$value": "\"Space Mono\", monospace"
            },
            "sans": {
                "$type": "fontFamily",
                "$value": "\"Plus Jakarta Sans\", \"Archivo\", sans-serif"
            }
        },
        "lineHeight": {
            "base": { "$type": "number", "$value": "1.5" },
            "tight": { "$type": "number", "$value": "1.2" }
        },
        "size": {
            "lg": { "$type": "fontSize", "$value": "1.2rem" },
            "md": { "$type": "fontSize", "$value": "1rem" },
            "xl": { "$type": "fontSize", "$value": "1.6rem" }
        },
        "weight": {
            "bold": { "$type": "fontWeight", "$value": "700" },
            "medium": { "$type": "fontWeight", "$value": "500" },
            "regular": { "$type": "fontWeight", "$value": "400" },
            "semibold": { "$type": "fontWeight", "$value": "600" }
        }
    }
}
