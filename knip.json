{
    "treatConfigHintsAsErrors": true,
    "workspaces": {
        ".": {
            "entry": ["scripts/*.mjs"],
            "project": ["scripts/**/*.mjs"]
        },
        "apps/website": {
            "entry": ["src/*/*.ts"],
            "paths": {
                "@api/*": ["./src/api/*"],
                "@components/*": ["./src/components/*"],
                "@config/*": ["./src/config/*"],
                "@features/*": ["./src/features/*"]
            },
            "project": ["src/*/*.ts", "!node_modules/**"]
        },
        "apps/bartleby": {
            "entry": ["src/main.ts", "src/runtime/*.ts", "scripts/*.mjs"],
            "project": ["src/**/*.ts", "scripts/**/*.mjs", "!node_modules/**"]
        },
        "mobile": {
            "entry": ["src/**/*.ts", "src/**/*.tsx"],
            "paths": {
                "@api/*": ["./src/api/*"],
                "@config/*": ["./src/config/*"],
                "@features/*": ["./src/features/*"]
            },
            "project": [
                "App.tsx",
                "src/**/*.ts",
                "src/**/*.tsx",
                "!node_modules/**"
            ]
        },
        "packages/frontend": {
            "entry": ["src/renderer/app.ts", "scripts/*.mjs", "tests/*.mjs"],
            "project": [
                "src/**/*.ts",
                "scripts/**/*.mjs",
                "tests/**/*.mjs",
                "!dist/**",
                "!node_modules/**"
            ]
        },
        "packages/contracts": {
            "project": ["src/**/*.ts", "!dist/**", "!node_modules/**"]
        }
    }
}
