{
    "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
    "treatConfigHintsAsErrors": true,
    "workspaces": {
        ".": {
            "entry": ["scripts/*.mjs"],
            "project": ["scripts/**/*.mjs"]
        },
        "electron": {
            "entry": [
                "main.ts",
                "preload.ts",
                "e2e/**/*.ts",
                "renderer/app.ts",
                "scripts/*.mjs",
                "tests/*.mjs"
            ],
            "paths": {
                "@main/*": ["./main/*"],
                "@renderer/*": ["./renderer/*"],
                "@shared/*": ["./types/*"]
            },
            "project": [
                "**/*.ts",
                "**/*.mjs",
                "!**/*.md",
                "!dist/**",
                "!node_modules/**"
            ]
        },
        "mobile": {
            "entry": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"],
            "paths": {
                "@api/*": ["./src/api/*"],
                "@config/*": ["./src/config/*"],
                "@features/*": ["./src/features/*"]
            },
            "project": [
                "App.tsx",
                "src/**/*.ts",
                "src/**/*.tsx",
                "!node_modules/**"
            ]
        },
        "packages/contracts": {
            "entry": ["src/index.ts"],
            "project": ["src/**/*.ts", "!dist/**", "!node_modules/**"]
        }
    }
}
