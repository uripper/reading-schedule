{
    "$schema": "https://schema.tauri.app/config/2",
    "app": {
        "security": {
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/book_covers/**",
                    "$APPDATA/covers/**",
                    "$APPLOCALDATA/book_covers/**",
                    "$APPLOCALDATA/covers/**"
                ]
            },
            "csp": null
        },
        "windows": [
            {
                "height": 1100,
                "maximized": true,
                "title": "Bartleby",
                "width": 1800
            }
        ],
        "withGlobalTauri": false
    },
    "build": {
        "beforeBuildCommand": "pnpm build",
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "targets": "all"
    },
    "identifier": "com.bartleby.app",
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/uripper/Bartleby/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RkJFQjc5QkRDRjBEQzYKUldUR0RjKzllZXY3ZHh0SEFJNDYzejUwVDVubDlqc0FFbnVGYnBVWnlBQWpXc3hPYWhyTFYwMmEK",
            "windows": {
                "installMode": "passive"
            }
        }
    },
    "productName": "Bartleby",
    "version": "0.1.4-alpha"
}
