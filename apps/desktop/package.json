{
  "name": "@reading-schedule/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsup src/main.ts src/preload.ts --format cjs --out-dir dist --sourcemap --platform node --external electron",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run build && electron dist/main.js",
    "test": "echo 'desktop test: add electron smoke tests'",
    "lint": "echo 'desktop lint: add eslint config'"
  },
  "dependencies": {
    "@reading-schedule/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
