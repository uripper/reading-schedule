{
  "name": "reading-schedule",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev:desktop": "npm --prefix electron run start",
    "dev:windows": "bash ./scripts/run_windows_gui_from_wsl.sh",
    "dev:windows:hot": "bash ./scripts/run_windows_gui_hot_from_wsl.sh",
    "prepare": "npm run hooks:install",
    "hooks:install": "bash ./scripts/install_git_hooks.sh",
    "ci:local": "npm run lint:python && npm run test:python && npm run typecheck:desktop && npm run lint:desktop && npm run build:desktop && npm run test:desktop",
    "build:desktop": "npm --prefix electron run build",
    "typecheck:desktop": "npm --prefix electron run typecheck",
    "lint:desktop": "npm --prefix electron run lint",
    "test:desktop": "npm --prefix electron run test:node",
    "lint:desktop:fix": "npm --prefix electron run lint:fix",
    "lint:desktop:jsdoc": "npm --prefix electron run lint -- -c eslint.jsdoc.config.mjs",
    "lint:desktop:jsdoc:fix": "npm --prefix electron run lint:fix -- -c eslint.jsdoc.config.mjs --fix",
    "lint:python": ".venv/bin/ruff check src",
    "lint:python:fix": ".venv/bin/ruff check --fix src",
    "lint:python:fix:unsafe": ".venv/bin/ruff check --fix --unsafe-fixes src",
    "lint:python:all": ".venv/bin/ruff check src tests",
    "audit": "node ./scripts/style_audit.mjs",
    "issues:sync": "bash ./scripts/sync_issues.sh",
    "test:python": ".venv/bin/pytest -q",
    "sonar:scan": "sonar-scanner -Dsonar.host.url=${SONAR_HOST_URL:-http://localhost:9000} -Dsonar.token=$SONAR_TOKEN"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "eslint": "^10.0.1",
    "eslint-plugin-jsdoc": "^62.7.0",
    "typescript": "^5.7.3"
  }
}
