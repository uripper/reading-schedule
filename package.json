{
    "dependencies": {
        "pnpm": "^10.31.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.6",
        "@types/node": "^25.5.0",
        "@typescript-eslint/parser": "^8.57.0",
        "eslint": "^10.0.3",
        "eslint-plugin-jsdoc": "^62.8.0",
        "eslint-plugin-tsdoc": "0.5.2",
        "jscpd": "^4.0.8",
        "knip": "^5.86.0",
        "tslog": "^4.10.2",
        "type-coverage": "^2.29.7",
        "typescript": "^5.9.3"
    },
    "name": "bartleby",
    "description": "Bartleby is a reading scheduler to help you read more books",
    "author": {"name": "uripper"},
    "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "electron-winstaller",
            "esbuild",
            "inotify"
        ],
        "overrides": {
            "electron@<=1.8.2-beta4": ">=1.8.2-beta5",
            "electron@<0.33.5": ">=0.33.5",
            "electron@<1.6.8": ">=1.6.8",
            "electron@<1.6.14": ">=1.6.14",
            "electron@<6.1.11": ">=6.1.11",
            "electron@<7.2.4": ">=7.2.4",
            "electron@<9.4.0": ">=9.4.0",
            "electron@<11.5.0": ">=11.5.0",
            "electron@<13.6.6": ">=13.6.6",
            "electron@<15.5.0": ">=15.5.0",
            "electron@<15.5.5": ">=15.5.5",
            "electron@<18.3.7": ">=18.3.7",
            "electron@<22.3.6": ">=22.3.6",
            "electron@<22.3.19": ">=22.3.19",
            "electron@<22.3.24": ">=22.3.24",
            "electron@<22.3.25": ">=22.3.25",
            "electron@<28.3.2": ">=28.3.2",
            "electron@<35.7.5": ">=35.7.5"
        }
    },
    "private": true,
    "scripts": {
        "audit": "node ./scripts/style_audit.mjs",
        "audit:local": "pnpm run lint:python && pnpm run typecheck:python && pnpm run test:python && pnpm run typecheck:contracts && pnpm run typecheck:website && pnpm run typecheck:desktop && pnpm run lint:website && pnpm run lint:desktop && pnpm run build:website && pnpm run build:desktop && pnpm run test:website && pnpm run test:desktop",
        "build:contracts": "pnpm -C packages/contracts run build",
        "build:desktop": "pnpm -C electron run build",
        "build:mobile": "pnpm -C mobile run typecheck",
        "build:website": "pnpm -C apps/website run build",
        "ci:local": "pnpm run typecheck:python && pnpm run typecheck:contracts",
        "dev:desktop": "pnpm -C electron run start",
        "dev:mobile": "pnpm -C mobile run dev:tunnel",
        "dev:mobile:android": "pnpm -C mobile run dev:android",
        "dev:mobile:ios": "pnpm -C mobile run dev:ios",
        "dev:mobile:tunnel": "pnpm -C mobile run dev:tunnel",
        "dist:desktop:win": "pnpm -C electron run dist:win",
        "dev:planner-api": ".venv/bin/python -m reading_plan.http_api",
        "dev:website": "pnpm -C apps/website run dev",
        "dev:website:hot": "pnpm -C apps/website run dev:hot",
        "dev:windows": "pnpm -C packages/contracts build && bash ./scripts/run_windows_gui_from_wsl.sh",
        "dev:windows:hot": "pnpm -C packages/contracts build && bash ./scripts/run_windows_gui_hot_from_wsl.sh",
        "format:python": ".venv/bin/ruff check src --fix",
        "format:typescript": "pnpm biome check apps electron mobile packages --write",
        "hooks:install": "node ./scripts/install_git_hooks.mjs",
        "issues:sync": "bash ./scripts/sync_issues.sh",
        "knip": "knip",
        "knip:debug": "knip --debug",
        "knip:deps": "knip --dependencies",
        "knip:files": "knip --files",
        "knip:prod": "knip --production",
        "knip:strict": "knip --strict",
        "lint:desktop": "biome check electron",
        "lint:desktop:fix": "biome check electron --write",
        "lint:desktop:fix:unsafe": "biome check electron --write --unsafe",
        "lint:desktop:jsdoc": "pnpm -C electron run lint -- -c eslint.jsdoc.config.mjs",
        "lint:desktop:jsdoc:fix": "pnpm -C electron run lint:fix -- -c eslint.jsdoc.config.mjs --fix",
        "lint:mobile": "pnpm -C mobile run lint",
        "lint:mobile:fix": "pnpm -C mobile run lint:fix",
        "lint:packages": "biome check packages",
        "lint:python": ".venv/bin/ruff check src",
        "lint:python:all": ".venv/bin/ruff check src tests",
        "lint:python:fix": ".venv/bin/ruff check --fix src",
        "lint:python:fix:unsafe": ".venv/bin/ruff check --fix --unsafe-fixes src",
        "lint:website": "biome check apps/website",
        "lint:website:fix": "biome check apps/website --write",
        "lint:website:fix:unsafe": "biome check apps/website --write --unsafe-fixes",
        "prepare": "pnpm run hooks:install",
        "test:desktop": "pnpm -C electron run test:node",
        "test:python": ".venv/bin/pytest -q",
        "test:website": "pnpm -C apps/website run test",
        "typecheck:contracts": "pnpm -C packages/contracts run typecheck",
        "typecheck:desktop": "pnpm -C electron run typecheck",
        "typecheck:mobile": "pnpm -C mobile run typecheck",
        "typecheck:python": ".venv/bin/ty check .",
        "typecheck:website": "pnpm -C apps/website run typecheck",
        "typecov": "pnpm run typecov:main && pnpm run typecov:renderer",
        "typecov:main": "type-coverage -p electron/tsconfig.main.json --detail --show-relative-path --cache",
        "typecov:renderer": "type-coverage -p electron/tsconfig.renderer.json --detail --show-relative-path --cache",
        "typecov:strict": "pnpm run typecov:strict:main && pnpm run typecov:strict:renderer",
        "typecov:strict:main": "type-coverage -p electron/tsconfig.main.json --detail --show-relative-path --cache --strict",
        "typecov:strict:renderer": "type-coverage -p electron/tsconfig.renderer.json --detail --show-relative-path --cache --strict"
    },
    "version": "0.2.0"
}
