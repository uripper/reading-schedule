{
  "name": "reading-schedule-monorepo",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "sonar:scan": "sonar-scanner -Dsonar.host.url=${SONAR_HOST_URL:-http://localhost:9000} -Dsonar.token=$SONAR_TOKEN",
    "dev:client": "pnpm --filter @reading-schedule/client dev",
    "dev:desktop": "npm --prefix electron run start",
    "dev:desktop:full": "npm --prefix electron run start",
    "dev:desktop:shell": "pnpm --filter @reading-schedule/desktop dev",
    "dev:desktop:shell:full": "pnpm --parallel --filter @reading-schedule/client --filter @reading-schedule/desktop dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
