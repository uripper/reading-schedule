{
    "author": {
        "name": "uripper"
    },
    "description": "Bartleby is a reading scheduler to help you read more books",
    "devDependencies": {
        "@types/node": "^25.9.5",
        "html-validate": "10.17.0",
        "jscpd": "^4.2.5",
        "knip": "^5.88.1",
        "oxlint-plugin-complexity": "4.1.0",
        "oxlint-plugin-eslint": "1.91.0",
        "stylelint": "^17.14.1",
        "tslog": "^4.11.0",
        "type-coverage": "^2.31.2",
        "type-coverage-core": "^2.31.2",
        "typescript": "^5.9.3",
        "vite-plus": "catalog:"
    },
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "license": "0BSD",
    "name": "bartleby",
    "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
    "private": true,
    "scripts": {
        "bench:planner": "cargo run --release --locked --manifest-path apps/bartleby/src-tauri/Cargo.toml --bin planner_benchmark --",
        "build:app": "vp run --fail-if-no-match --filter bartleby-app build",
        "build:contracts": "vp run --fail-if-no-match --filter @reading-schedule/contracts build",
        "build:desktop": "pnpm run build:app",
        "build:frontend": "vp run --fail-if-no-match --filter @reading-schedule/frontend build",
        "build:mobile": "vp run --fail-if-no-match --filter reading-schedule-mobile typecheck",
        "build:website": "vp run --fail-if-no-match --filter reading-schedule-website build",
        "check:typescript": "vp lint . --format unix",
        "ci:local": "pnpm run version:check && pnpm run release-notes:check && pnpm run deps:check && pnpm run check:typescript && pnpm run format:check && pnpm run lint:web-assets && pnpm run typecheck:contracts && pnpm run typecheck:desktop",
        "ci:local:extended": "pnpm run ci:local && pnpm run typecheck:website && pnpm run lint:website && pnpm run lint:desktop && pnpm run build:website && pnpm run build:desktop && pnpm run test:website && pnpm run test:desktop && pnpm run styleaudit",
        "deps:check": "node ./scripts/check-dependency-versions.mjs",
        "dev:app": "pnpm -C apps/bartleby run tauri dev",
        "dev:app:android": "pnpm -C apps/bartleby run dev:android",
        "dev:app:ios": "pnpm -C apps/bartleby run dev:ios",
        "dev:desktop": "pnpm run dev:app",
        "dev:mobile": "vp run --fail-if-no-match --filter reading-schedule-mobile dev:tunnel",
        "dev:mobile:android": "vp run --fail-if-no-match --filter reading-schedule-mobile dev:android",
        "dev:mobile:ios": "vp run --fail-if-no-match --filter reading-schedule-mobile dev:ios",
        "dev:mobile:tunnel": "vp run --fail-if-no-match --filter reading-schedule-mobile dev:tunnel",
        "dev:website": "vp run --fail-if-no-match --filter reading-schedule-website dev",
        "dev:website:hot": "vp run --fail-if-no-match --filter reading-schedule-website dev:hot",
        "dev:windows": "pnpm -C packages/contracts build && bash ./scripts/run_windows_gui_from_wsl.sh",
        "dev:windows:hot": "pnpm -C packages/contracts build && bash ./scripts/run_windows_gui_hot_from_wsl.sh",
        "dist:app": "pnpm -C apps/bartleby run dist",
        "dist:desktop": "pnpm run dist:app",
        "dist:desktop:win": "pnpm run dist:app",
        "format:check": "vp fmt apps mobile packages scripts vite.config.ts stylelint.config.mjs .htmlvalidate.json --check",
        "format:typescript": "vp fmt apps mobile packages scripts vite.config.ts stylelint.config.mjs .htmlvalidate.json",
        "hooks:install": "node ./scripts/install_git_hooks.mjs",
        "issues:sync": "bash ./scripts/sync_issues.sh",
        "knip": "knip",
        "knip:debug": "knip --debug",
        "knip:deps": "knip --dependencies",
        "knip:files": "knip --files",
        "knip:prod": "knip --production",
        "knip:strict": "knip --strict",
        "lint:app": "vp run --fail-if-no-match --filter bartleby-app lint",
        "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\" --ignore-path .gitignore",
        "lint:desktop": "pnpm run lint:app && pnpm run lint:frontend && pnpm run lint:web-assets && pnpm run lint:rust",
        "lint:desktop:fix": "vp lint apps/bartleby packages/frontend --fix && vp fmt apps/bartleby packages/frontend",
        "lint:desktop:fix:unsafe": "vp lint apps/bartleby packages/frontend --fix --fix-suggestions --fix-dangerously && vp fmt apps/bartleby packages/frontend",
        "lint:frontend": "vp run --fail-if-no-match --filter @reading-schedule/frontend lint",
        "lint:html": "html-validate \"apps/bartleby/*.html\" \"apps/website/*.html\" \"packages/frontend/*.html\"",
        "lint:mobile": "vp run --fail-if-no-match --filter reading-schedule-mobile lint",
        "lint:mobile:fix": "vp lint mobile --fix && vp fmt mobile",
        "lint:packages": "vp lint packages --format unix && vp fmt packages --check",
        "lint:rust": "cargo clippy --locked --manifest-path packages/planner/Cargo.toml -- -D warnings && cargo clippy --locked --manifest-path apps/bartleby/src-tauri/Cargo.toml -- -D warnings",
        "lint:web-assets": "pnpm run lint:css && pnpm run lint:html",
        "lint:website": "vp run --fail-if-no-match --filter reading-schedule-website lint",
        "lint:website:fix": "vp lint apps/website --fix && vp fmt apps/website",
        "lint:website:fix:unsafe": "vp lint apps/website --fix --fix-suggestions --fix-dangerously && vp fmt apps/website",
        "prepare": "pnpm run hooks:install",
        "release-notes:check": "node ./scripts/release-notes.mjs check desktop",
        "release-notes:print": "node ./scripts/release-notes.mjs print desktop",
        "release-notes:scaffold": "node ./scripts/release-notes.mjs scaffold",
        "state:recover:app": "pnpm -C apps/bartleby run state:recover --",
        "styleaudit": "node ./scripts/style_audit.mjs",
        "test:desktop": "pnpm run test:frontend && pnpm run test:scripts && pnpm -C apps/bartleby run test",
        "test:frontend": "vp run --fail-if-no-match --filter @reading-schedule/frontend test",
        "test:scripts": "node --test scripts/release-notes.test.mjs scripts/lint/*.test.mjs",
        "test:website": "vp run --fail-if-no-match --filter reading-schedule-website test",
        "typecheck:app": "vp run --fail-if-no-match --filter bartleby-app typecheck",
        "typecheck:contracts": "vp run --fail-if-no-match --filter @reading-schedule/contracts typecheck",
        "typecheck:desktop": "pnpm run typecheck:app",
        "typecheck:frontend": "vp run --fail-if-no-match --filter @reading-schedule/frontend typecheck",
        "typecheck:mobile": "vp run --fail-if-no-match --filter reading-schedule-mobile typecheck",
        "typecheck:website": "vp run --fail-if-no-match --filter reading-schedule-website typecheck",
        "typecov": "pnpm run typecov:main && pnpm run typecov:renderer",
        "typecov:main": "type-coverage -p apps/bartleby/tsconfig.json --detail --show-relative-path --cache",
        "typecov:renderer": "type-coverage -p packages/frontend/tsconfig.json --detail --show-relative-path --cache",
        "typecov:strict": "pnpm run typecov:strict:main && pnpm run typecov:strict:renderer",
        "typecov:strict:main": "type-coverage -p apps/bartleby/tsconfig.json --detail --show-relative-path --cache --strict",
        "typecov:strict:renderer": "type-coverage -p packages/frontend/tsconfig.json --detail --show-relative-path --cache --strict",
        "version:check": "node ./scripts/set-app-version.mjs --check",
        "version:set": "node ./scripts/set-app-version.mjs"
    },
    "version": "0.2.0-alpha"
}
