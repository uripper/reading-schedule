{
    "author": {
        "name": "uripper"
    },
    "description": "Bartleby is a reading scheduler to help you read more books",
    "devDependencies": {
        "@biomejs/biome": "2.4.6",
        "@types/node": "^25.9.5",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^10.8.0",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-tsdoc": "0.5.2",
        "jscpd": "^4.2.5",
        "knip": "^5.88.1",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "tslog": "^4.11.0",
        "type-coverage": "^2.30.1",
        "type-coverage-core": "^2.30.1",
        "typescript": "^5.9.3"
    },
    "name": "bartleby",
    "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "inotify"
        ]
    },
    "private": true,
    "scripts": {
        "build:app": "pnpm -C apps/bartleby run build",
        "build:contracts": "pnpm -C packages/contracts run build",
        "build:desktop": "pnpm run build:app",
        "build:frontend": "pnpm -C packages/frontend run build",
        "build:mobile": "pnpm -C mobile run typecheck",
        "build:website": "pnpm -C apps/website run build",
        "ci:local": "pnpm run version:check && pnpm run deps:check && pnpm run typecheck:contracts && pnpm run typecheck:desktop",
        "ci:local:extended": "pnpm run version:check && pnpm run deps:check && pnpm run typecheck:contracts && pnpm run typecheck:website && pnpm run typecheck:desktop && pnpm run lint:website && pnpm run lint:desktop && pnpm run build:website && pnpm run build:desktop && pnpm run test:website && pnpm run test:desktop && pnpm run styleaudit",
        "deps:check": "node ./scripts/check-dependency-versions.mjs",
        "dev:app": "pnpm -C apps/bartleby run tauri dev",
        "dev:app:android": "pnpm -C apps/bartleby run dev:android",
        "dev:app:ios": "pnpm -C apps/bartleby run dev:ios",
        "dev:desktop": "pnpm run dev:app",
        "dev:mobile": "pnpm -C mobile run dev:tunnel",
        "dev:mobile:android": "pnpm -C mobile run dev:android",
        "dev:mobile:ios": "pnpm -C mobile run dev:ios",
        "dev:mobile:tunnel": "pnpm -C mobile run dev:tunnel",
        "dev:website": "pnpm -C apps/website run dev",
        "dev:website:hot": "pnpm -C apps/website run dev:hot",
        "dev:windows": "pnpm -C packages/contracts build && bash ./scripts/run_windows_gui_from_wsl.sh",
        "dev:windows:hot": "pnpm -C packages/contracts build && bash ./scripts/run_windows_gui_hot_from_wsl.sh",
        "dist:app": "pnpm -C apps/bartleby run dist",
        "dist:desktop": "pnpm run dist:app",
        "dist:desktop:win": "pnpm run dist:app",
        "format:typescript": "pnpm biome check apps mobile packages scripts --write",
        "hooks:install": "node ./scripts/install_git_hooks.mjs",
        "issues:sync": "bash ./scripts/sync_issues.sh",
        "knip": "knip",
        "knip:debug": "knip --debug",
        "knip:deps": "knip --dependencies",
        "knip:files": "knip --files",
        "knip:prod": "knip --production",
        "knip:strict": "knip --strict",
        "lint:app": "pnpm -C apps/bartleby run lint",
        "lint:desktop": "pnpm run lint:app && pnpm run lint:frontend && pnpm run lint:rust",
        "lint:desktop:fix": "pnpm exec biome check apps/bartleby packages/frontend --write",
        "lint:desktop:fix:unsafe": "pnpm exec biome check apps/bartleby packages/frontend --write --unsafe",
        "lint:frontend": "pnpm -C packages/frontend run lint",
        "lint:mobile": "biome check mobile",
        "lint:mobile:fix": "biome check mobile --write",
        "lint:packages": "biome check packages",
        "lint:rust": "cargo clippy --locked --manifest-path apps/bartleby/src-tauri/Cargo.toml -- -D warnings",
        "lint:website": "biome check apps/website",
        "lint:website:fix": "biome check apps/website --write",
        "lint:website:fix:unsafe": "biome check apps/website --write --unsafe-fixes",
        "prepare": "pnpm run hooks:install",
        "state:recover:app": "pnpm -C apps/bartleby run state:recover --",
        "styleaudit": "node ./scripts/style_audit.mjs",
        "test:desktop": "pnpm run test:frontend && pnpm -C apps/bartleby run test",
        "test:frontend": "pnpm -C packages/frontend run test",
        "test:website": "pnpm -C apps/website run test",
        "typecheck:app": "pnpm -C apps/bartleby run typecheck",
        "typecheck:contracts": "pnpm -C packages/contracts run typecheck",
        "typecheck:desktop": "pnpm run typecheck:app",
        "typecheck:frontend": "pnpm -C packages/frontend run typecheck",
        "typecheck:mobile": "pnpm -C mobile run typecheck",
        "typecheck:website": "pnpm -C apps/website run typecheck",
        "typecov": "pnpm run typecov:main && pnpm run typecov:renderer",
        "typecov:main": "type-coverage -p apps/bartleby/tsconfig.json --detail --show-relative-path --cache",
        "typecov:renderer": "type-coverage -p packages/frontend/tsconfig.json --detail --show-relative-path --cache",
        "typecov:strict": "pnpm run typecov:strict:main && pnpm run typecov:strict:renderer",
        "typecov:strict:main": "type-coverage -p apps/bartleby/tsconfig.json --detail --show-relative-path --cache --strict",
        "typecov:strict:renderer": "type-coverage -p packages/frontend/tsconfig.json --detail --show-relative-path --cache --strict",
        "version:check": "node ./scripts/set-app-version.mjs --check",
        "version:set": "node ./scripts/set-app-version.mjs"
    },
    "version": "0.1.4-alpha"
}
