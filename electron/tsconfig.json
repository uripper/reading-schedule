{
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmitOnError": true,
        "outDir": "dist",
        "paths": {
            "@main/*": ["./main/*"],
            "@renderer/*": ["./renderer/*"],
            "@shared/*": ["./types/*"]
        },
        "rootDir": ".",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023"
    }
}
