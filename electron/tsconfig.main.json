{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "module": "CommonJS",
        "moduleResolution": "Node",
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "strictNullChecks": true,
        "types": ["node", "electron"]
    },
    "extends": "./tsconfig.json",
    "include": ["*.ts", "contracts/**/*.ts", "main/**/*.ts", "types/**/*.ts"]
}
