{
  "$description": "Reading Schedule design tokens (DTCG style)",
  "$schema": "https://www.designtokens.org/schema.json",
  "color": {
    "neutral": {
      "0": { "$value": "#ffffff", "$type": "color" },
      "50": { "$value": "#f5f8fc", "$type": "color" },
      "100": { "$value": "#e9eef7", "$type": "color" },
      "200": { "$value": "#d6dfed", "$type": "color" },
      "300": { "$value": "#b8c6dc", "$type": "color" },
      "500": { "$value": "#70829f", "$type": "color" },
      "700": { "$value": "#32435d", "$type": "color" },
      "850": { "$value": "#1d2940", "$type": "color" },
      "900": { "$value": "#131d2f", "$type": "color" },
      "950": { "$value": "#0c1321", "$type": "color" }
    },
    "brand": {
      "300": { "$value": "#8dd0ff", "$type": "color" },
      "500": { "$value": "#3f9ef4", "$type": "color" },
      "700": { "$value": "#1566bf", "$type": "color" }
    },
    "success": {
      "400": { "$value": "#3ecf8e", "$type": "color" },
      "500": { "$value": "#22b86f", "$type": "color" }
    },
    "warning": {
      "500": { "$value": "#f3ad3d", "$type": "color" }
    },
    "danger": {
      "400": { "$value": "#ff7f92", "$type": "color" },
      "500": { "$value": "#e85f75", "$type": "color" }
    },
    "overlay": {
      "60": { "$value": "rgba(5, 10, 18, 0.6)", "$type": "color" }
    }
  },
  "space": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" }
  },
  "size": {
    "target": {
      "minimum": { "$value": "44px", "$type": "dimension" }
    },
    "header": {
      "height": { "$value": "72px", "$type": "dimension" }
    }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "elevation": {
    "sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.26)", "$type": "shadow" },
    "md": { "$value": "0 10px 20px rgba(0, 0, 0, 0.25)", "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "180ms", "$type": "duration" },
      "slow": { "$value": "260ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" }
    }
  },
  "typography": {
    "family": {
      "sans": {
        "$value": "\"IBM Plex Sans\", \"Segoe UI Variable\", \"Segoe UI\", sans-serif",
        "$type": "fontFamily"
      },
      "heading": {
        "$value": "\"Space Grotesk\", \"IBM Plex Sans\", sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "\"IBM Plex Mono\", \"Cascadia Code\", monospace",
        "$type": "fontFamily"
      }
    },
    "size": {
      "xs": { "$value": "0.75rem", "$type": "fontSize" },
      "sm": { "$value": "0.875rem", "$type": "fontSize" },
      "md": { "$value": "1rem", "$type": "fontSize" },
      "lg": { "$value": "1.2rem", "$type": "fontSize" },
      "xl": { "$value": "1.6rem", "$type": "fontSize" }
    },
    "lineHeight": {
      "tight": { "$value": "1.2", "$type": "number" },
      "base": { "$value": "1.5", "$type": "number" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    }
  },
  "semantic": {
    "light": {
      "bg": { "$value": "{color.neutral.50}", "$type": "color" },
      "bgElevated": { "$value": "{color.neutral.0}", "$type": "color" },
      "surface": { "$value": "{color.neutral.0}", "$type": "color" },
      "surfaceMuted": { "$value": "{color.neutral.100}", "$type": "color" },
      "border": { "$value": "{color.neutral.200}", "$type": "color" },
      "text": { "$value": "{color.neutral.950}", "$type": "color" },
      "textMuted": { "$value": "{color.neutral.700}", "$type": "color" },
      "brand": { "$value": "{color.brand.700}", "$type": "color" },
      "brandStrong": { "$value": "{color.brand.500}", "$type": "color" },
      "success": { "$value": "{color.success.500}", "$type": "color" },
      "danger": { "$value": "{color.danger.500}", "$type": "color" },
      "warning": { "$value": "{color.warning.500}", "$type": "color" },
      "focusRing": { "$value": "{color.brand.500}", "$type": "color" },
      "overlay": { "$value": "rgba(8, 15, 26, 0.35)", "$type": "color" }
    },
    "dark": {
      "bg": { "$value": "{color.neutral.950}", "$type": "color" },
      "bgElevated": { "$value": "{color.neutral.900}", "$type": "color" },
      "surface": { "$value": "{color.neutral.900}", "$type": "color" },
      "surfaceMuted": { "$value": "{color.neutral.850}", "$type": "color" },
      "border": { "$value": "{color.neutral.700}", "$type": "color" },
      "text": { "$value": "{color.neutral.50}", "$type": "color" },
      "textMuted": { "$value": "{color.neutral.300}", "$type": "color" },
      "brand": { "$value": "{color.brand.300}", "$type": "color" },
      "brandStrong": { "$value": "{color.brand.500}", "$type": "color" },
      "success": { "$value": "{color.success.400}", "$type": "color" },
      "danger": { "$value": "{color.danger.400}", "$type": "color" },
      "warning": { "$value": "{color.warning.500}", "$type": "color" },
      "focusRing": { "$value": "{color.brand.300}", "$type": "color" },
      "overlay": { "$value": "{color.overlay.60}", "$type": "color" }
    }
  }
}
