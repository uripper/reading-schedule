{
    "compilerOptions": {
        "lib": ["ES2023", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmitOnError": true,
        "outDir": "dist",
        "rootDir": ".",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023"
    },
    "include": ["renderer/**/*.ts", "renderer/**/*.d.ts", "types/**/*.ts"]
}
